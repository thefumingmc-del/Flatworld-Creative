extends RefCounted
class_name RecipeRegistry

# This facade keeps the currently implemented Flatworld ingredient-map recipes separate
# from the official Java recipe registry. The latter is populated by the verified importer;
# its contents are not automatically executable until each recipe serializer is implemented.
const REGISTRY_ROOT := "res://assets/data/registries/26.3/"
const DATA_ROOT := "res://assets/data/"
static var _sample_recipes: Dictionary = {}
static var _vanilla_index: Dictionary = {}
static var _loaded := false

static func load_data(force_reload: bool = false) -> void:
    if _loaded and not force_reload:
        return
    _sample_recipes.clear()
    _vanilla_index.clear()
    var sample_doc := _read_json(DATA_ROOT + "recipes.json")
    _sample_recipes = sample_doc.get("recipes", {})
    var vanilla_doc := _read_json(REGISTRY_ROOT + "vanilla_recipes_index.json")
    _vanilla_index = vanilla_doc.get("recipes", {})
    # The partial legacy file is retained as data, but explicitly marked sample-only.
    if _vanilla_index.is_empty():
        var legacy_doc := _read_json(REGISTRY_ROOT + "recipes.json")
        if str(legacy_doc.get("source_status", "")).contains("sample"):
            var legacy_samples: Variant = legacy_doc.get("recipes", {})
            if legacy_samples is Dictionary and not legacy_samples.is_empty():
                _sample_recipes = legacy_samples
    _loaded = true

static func _read_json(path: String) -> Dictionary:
    if not FileAccess.file_exists(path):
        return {}
    var file := FileAccess.open(path, FileAccess.READ)
    if file == null:
        return {}
    var parsed: Variant = JSON.parse_string(file.get_as_text())
    return parsed if parsed is Dictionary else {}

static func get_sample_recipes() -> Dictionary:
    load_data()
    return _sample_recipes.duplicate(true)

static func get_sample_recipe(recipe_id: String) -> Dictionary:
    load_data()
    var value: Variant = _sample_recipes.get(recipe_id, {})
    return value.duplicate(true) if value is Dictionary else {}

static func get_vanilla_recipe_ids() -> Array[String]:
    load_data()
    var result: Array[String] = []
    for key in _vanilla_index.keys():
        result.append(str(key))
    result.sort()
    return result

static func has_vanilla_recipe_data() -> bool:
    load_data()
    return not _vanilla_index.is_empty()

static func get_vanilla_recipe_definition(recipe_id: String) -> Dictionary:
    load_data()
    var key := recipe_id if recipe_id.contains(":") else "minecraft:" + recipe_id
    if not _vanilla_index.has(key):
        # Compatibility for indexes generated by the early migration prototype.
        key = "minecraft:recipe/" + recipe_id.trim_prefix("minecraft:")
    var row: Variant = _vanilla_index.get(key, {})
    if not row is Dictionary:
        return {}
    var relative_path := str(row.get("path", ""))
    if relative_path.is_empty():
        return {}
    return _read_json(REGISTRY_ROOT + "vanilla_reference/server_data/" + relative_path)
